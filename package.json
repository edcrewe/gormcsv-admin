{
  "name": "gormcsv-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "tsc -p tsconfig.server-spec.json && vitest run --config vitest.server.config.mts",
    "serve:ssr:gormcsv-admin": "node dist/gormcsv-admin/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.12.0",
    "@types/supertest": "^7.2.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
